@{
    ViewData["Title"] = "My Schedule";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 mb-5" style="max-width: 1400px;">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bolder mb-0">Your Schedule 📅</h2>
            <p class="text-muted">Manage your AI-generated study sessions</p>
        </div>
    </div>

    <div class="bg-white rounded-4 p-4 shadow-sm border border-light">
        <div id="calendar"></div>
    </div>
</div>

@section Scripts {
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js'></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var calendarEl = document.getElementById('calendar');

            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth', // Default view is month
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay'
                },
                firstDay: 1, // Week starts on Monday
                height: 'auto',

                // Magic: Here the calendar knows where to fetch events from our controller
                events: '@Url.Action("GetEvents", "Schedule")',

                // --- UI FIXES FOR FIGMA LOOK ---
                eventDisplay: 'block',     // Forces solid, colored background (pills) instead of dots
                displayEventTime: false,   // Hides the time (e.g., "13:10"), leaving only the topic name
                // -------------------------------

                eventTimeFormat: {
                    hour: '2-digit',
                    minute: '2-digit',
                    hour12: false // 24-hour format
                },
                eventClick: function(info) {
                    // Alert when clicking on a specific session
                    alert('Time to study: ' + info.event.title);
                }
            });

            calendar.render();
        });
    </script>
}