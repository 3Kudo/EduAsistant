<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduAsistant</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EduAsistant.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm custom-navbar">
            <div class="container">
                <a class="navbar-brand fw-bolder fs-4" asp-area="" asp-controller="Home" asp-action="Index">
                    <span style="color: var(--f-purple);">Edu</span>Asistant
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between align-items-center">
                    <ul class="navbar-nav flex-grow-1 ms-4">
                        <li class="nav-item">
                            <a class="nav-link nav-icon active" asp-controller="Home" asp-action="Index">🏠 Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-icon" href="#">📅 Schedule</a>
                        </li>
                    </ul>
                    <!-- Zamiast LoginPartial zróbmy proste powitanie z wylogowaniem w stylu aplikacji -->
                    <!-- Prawy panel użytkownika z rozwijanym menu (Dropdown) -->
                    <div class="dropdown">
                        <a href="#" class="d-flex align-items-center gap-3 text-decoration-none dropdown-toggle" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="fw-bold text-muted">@User.Identity?.Name?.Split('@')[0]</span>
                            <div class="fs-4 bg-light rounded-circle text-center" style="width: 40px; height: 40px; line-height: 40px; box-shadow: 0 2px 5px rgba(0,0,0,0.05);">👩‍🦰</div>
                        </a>

                        <!-- Menu rozwijane w stylu aplikacji -->
                        <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm mt-2" aria-labelledby="userDropdown" style="border-radius: 15px; min-width: 200px;">
                            <li>
                                <!-- Link do profilu Identity -->
                                <a class="dropdown-item fw-semibold text-muted py-2" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
                                    ⚙️ Profile Settings
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <!-- Formularz wylogowania Identity -->
                                <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                    <button type="submit" class="dropdown-item fw-semibold text-danger py-2">
                                        🚪 Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
