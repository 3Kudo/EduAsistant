<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduAsistant</title>

    <link rel="icon" type="image/png" href="~/images/purple.jpg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EduAsistant.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white shadow-sm mb-4 py-2" style="border-bottom-left-radius: 24px; border-bottom-right-radius: 24px;">
            <div class="container d-flex justify-content-between align-items-center">

                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/purple.jpg" alt="EduAsistant Logo" class="navbar-logo" />
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1 justify-content-center gap-4 mt-3 mt-sm-0">
                        <li class="nav-item">
                            <a class="nav-link fw-bold text-muted d-flex align-items-center gap-2 custom-nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <span class="nav-icon-emoji">🏠</span> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-bold text-muted d-flex align-items-center gap-2 custom-nav-link" asp-area="" asp-controller="Schedule" asp-action="Index">
                                <span class="nav-icon-emoji">📅</span> Schedule
                            </a>
                        </li>
                    </ul>

                    <div class="mt-3 mt-sm-0">
                        <partial name="_LoginPartial" />
                    </div>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>