@model EduAsistant.Models.Subject

@{
    ViewData["Title"] = Model.Name;
    var mainSyllabus = Model.Syllabuses?.FirstOrDefault();
    var topics = mainSyllabus?.Topics?.ToList() ?? new List<EduAsistant.Models.Topic>();
}

<div class="container mt-4" style="max-width: 700px;">

    <div class="d-flex align-items-center mb-5">
        <a asp-controller="Home" asp-action="Index" class="text-dark text-decoration-none fs-4 me-3 fw-bold">&lt;</a>
        <div>
            <h3 class="fw-bolder mb-0">@Model.Name</h3>
            <small class="text-muted fw-semibold">@topics.Count chapters - AI-structured</small>
        </div>
    </div>

    <div>
        @if (topics.Any())
        {
            int chapterIndex = 1;
            foreach (var topic in topics)
            {
                <div class="chapter-card bg-white rounded-4 mb-3 shadow-sm border border-light @(topic.IsCompleted ? "completed" : "")"
                     id="card-@topic.Id"
                     style="transition: transform 0.2s; overflow: hidden;">

                    <div class="p-3 d-flex justify-content-between align-items-center"
                         data-bs-toggle="collapse"
                         data-bs-target="#collapse-@topic.Id"
                         aria-expanded="false"
                         style="cursor: pointer;">

                        <div class="d-flex align-items-center gap-3" style="flex: 1; min-width: 0;">
                            <div class="status-circle @(topic.IsCompleted ? "completed" : "")"
                                 data-topic-id="@topic.Id"
                                 onclick="toggleCompletion(this, @topic.Id, event)"
                                 style="flex-shrink: 0; cursor: pointer; z-index: 10;">
                            </div>

                            <h6 class="chapter-title fw-bold mb-0 text-dark text-truncate" style="font-size: 1rem;">
                                @topic.Name
                                <span style="color: #F97316; font-weight: normal; margin-left: 8px; font-size: 0.9rem;">(@topic.TotalEstimatedMinutes min)</span>
                            </h6>
                        </div>

                        <div class="d-flex align-items-center gap-3 ps-2">
                            <div class="d-flex justify-content-center align-items-center rounded-circle"
                                 style="width: 32px; height: 32px; border: 1.5px solid #E5E7EB; color: #8B5CF6; flex-shrink: 0;">
                                <small>⏱</small>
                            </div>
                            <div class="chevron-icon text-dark fw-bold fs-5">&#x2304;</div>
                        </div>
                    </div>

                    <div class="collapse" id="collapse-@topic.Id">
                        <div class="p-4 pt-0">
                            <div class="p-3 rounded-4 mb-4" style="background-color: #F5F3FF;">
                                <h6 class="fw-bold mb-2" style="color: #8B5CF6; font-size: 0.8rem; letter-spacing: 0.5px;">AI SUMMARY</h6>
                                <p class="mb-0" style="font-size: 0.9rem; color: #374151;">
                                    This chapter introduces core concepts of @topic.Name. Focus on the practical implementation and real-world scenarios.
                                </p>
                            </div>
                            <div class="p-3 rounded-4" style="background-color: #FFF7ED;">
                                <h6 class="fw-bold mb-2" style="color: #F97316; font-size: 0.8rem; letter-spacing: 0.5px;">KEY DEFINITIONS</h6>
                                <p class="mb-0" style="font-size: 0.9rem; color: #374151;">
                                    Key terms and methodologies related to this module.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
                chapterIndex++;
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        function toggleCompletion(circleElement, topicId, event) {
            event.stopPropagation();
            const cardElement = document.getElementById('card-' + topicId);
            const url = '@Url.Action("ToggleTopicStatus", "Subjects")' + '?topicId=' + topicId;

            fetch(url, { method: 'POST' })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    if (data.isCompleted) {
                        circleElement.classList.add('completed');
                        cardElement.classList.add('completed');
                    } else {
                        circleElement.classList.remove('completed');
                        cardElement.classList.remove('completed');
                    }
                }
            })
            .catch(error => console.error('Błąd:', error));
        }
    </script>
}