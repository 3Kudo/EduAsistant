@model EduAsistant.Models.Subject

@{
    ViewData["Title"] = Model.Name;

    // Pobieramy pierwszy sylabus i jego tematy
    var mainSyllabus = Model.Syllabuses?.FirstOrDefault();
    var topics = mainSyllabus?.Topics?.ToList() ?? new List<EduAsistant.Models.Topic>();
}

<!-- Wyśrodkowany kontener ograniczający szerokość na PC -->
<div class="container mt-4" style="max-width: 700px;">

    <!-- Nagłówek -->
    <div class="d-flex align-items-center mb-5">
        <a asp-controller="Home" asp-action="Index" class="text-dark text-decoration-none fs-4 me-3 fw-bold">&lt;</a>
        <div>
            <h3 class="fw-bolder mb-0">@Model.Name</h3>
            <small class="text-muted fw-semibold">@topics.Count chapters - AI-structured</small>
        </div>
    </div>

    <!-- Lista tematów -->
    <div>
        @if (topics.Any())
        {
            int chapterIndex = 1;
            foreach (var topic in topics)
            {
                <!-- Karta (Card) - Flexbox, Cienie, Zaokrąglenia prosto z Bootstrapa -->
                <div class="bg-white rounded-4 p-3 mb-3 d-flex justify-content-between align-items-center shadow-sm border border-light"
                     style="transition: transform 0.2s; cursor: pointer;"
                     onmouseover="this.style.transform='translateY(-3px)'"
                     onmouseout="this.style.transform='translateY(0)'">

                    <!-- Lewa strona: Kółko + Tytuł -->
                    <div class="d-flex align-items-center gap-3">
                        <!-- Puste, zielone kółko statusu -->
                        <div class="rounded-circle border border-2" style="width: 24px; height: 24px; border-color: #10B981 !important; flex-shrink: 0;"></div>
                        <!-- Tytuł tematu -->
                        <h6 class="fw-bold mb-0 text-dark" style="font-size: 1rem;">Chapter @chapterIndex : @topic.Name</h6>
                    </div>

                    <!-- Prawa strona: Timer + Strzałka -->
                    <div class="d-flex align-items-center gap-3">
                        <!-- Fioletowe tło timera -->
                        <div class="rounded-circle d-flex justify-content-center align-items-center" style="width: 38px; height: 38px; background-color: #F5F3FF; color: #8B5CF6; font-size: 1.1rem;">
                            ⏱️
                        </div>
                        <!-- Strzałka w dół -->
                        <div class="text-muted fw-bold fs-5">
                            &#x2304; <!-- Kod HTML dla 'strzałki w dół' (chevron) -->
                        </div>
                    </div>

                </div>
                chapterIndex++;
            }
        }
        else
        {
            <div class="text-center p-5 rounded-4" style="background: #fff; border: 2px dashed #E5E7EB;">
                <p class="text-muted fs-5 mb-0">AI is still structuring this course or no syllabus was found.</p>
            </div>
        }
    </div>
</div>