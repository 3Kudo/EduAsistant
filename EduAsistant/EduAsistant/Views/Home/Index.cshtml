@model IEnumerable<EduAsistant.Models.Subject>
@{
    ViewData["Title"] = "Home";
    var userName = User.Identity?.Name?.Split('@')[0] ?? "Student";
}

<!-- Zauważ, że usunąłem sztuczne divy, opieramy się na siatce Bootstrapa! -->
<div class="row mb-5">
    <!-- Lewa strona: Powitanie -->
    <div class="col-md-6 mb-4 mb-md-0 d-flex flex-column justify-content-center">
        <h1 class="fw-bolder mb-1 text-capitalize" style="font-size: 2.5rem;">Hi @userName! 👋</h1>
        <p class="text-muted fs-5">Let's crush your goals today</p>
    </div>

    <!-- Prawa strona: Statystyki -->
    <div class="col-md-6">
        <div class="d-flex gap-3 h-100">
            <div class="stat-card orange flex-fill d-flex flex-column justify-content-center">
                <h2 class="fw-bold mb-0">12 🔥</h2>
                <span>Day streak</span>
            </div>
            <div class="stat-card green flex-fill d-flex flex-column justify-content-center">
                <h2 class="fw-bold mb-0">1.4h</h2>
                <span>Focused</span>
            </div>
        </div>
    </div>
</div>

<!-- Sekcja Kursów -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0">Your Courses</h3>
    <a asp-controller="Subjects" asp-action="Create" class="btn btn-purple d-flex align-items-center gap-2">
        <span class="fs-5">+</span> Add New Course
    </a>
</div>

<div class="course-grid">
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            int chaptersCount = item.Syllabuses?.SelectMany(s => s.Topics).Count() ?? 0;

            <div class="course-card" style="border-left: 8px solid @item.Color;">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">@item.Name</h5>
                    <span class="exam-badge">🗓 @item.ExamDate.ToString("MMM dd")</span>
                </div>
                <div class="text-muted small mt-1">@chaptersCount chapters</div>

                <div class="progress-bg">
                    <div class="progress-fill" style="width: 50%; background-color: @item.Color;"></div>
                </div>

                <div class="d-flex justify-content-between align-items-center fw-bold" style="font-size: 0.85rem;">
                    <span style="color: @item.Color;">50% mastered</span>
                    <a asp-controller="Subjects" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark fs-5">&gt;</a>
                </div>
            </div>
        }
    }
    else
    {
        {
            <div class="col-12 text-center p-5 rounded-4" style="background: #fff; border: 2px dashed #E5E7EB;">
                <p class="text-muted fs-5 mb-0">No courses yet. Click the "+ Add New Course" button above to upload your first syllabus!</p>
            </div>
        }
    }
</div>