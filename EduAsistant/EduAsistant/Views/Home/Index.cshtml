@model IEnumerable<EduAsistant.Models.Subject>
@{
    ViewData["Title"] = "Home";
    // Sprawdzamy, czy użytkownik jest zalogowany
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var userName = User.Identity?.Name?.Split('@')[0] ?? "Student";
}

@if (!isAuthenticated)
{
    <style>
        body {
            background-color: #8B5CF6 !important;
            margin: 0;
            padding: 0;
        }

        header {
            display: none !important;
        }
        /* Chowamy górny navbar */
        .container {
            max-width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        main {
            padding-bottom: 0 !important;
        }
    </style>

    <div class="d-flex flex-column justify-content-center align-items-center text-center w-100" style="min-height: 100vh;">

        <img src="~/images/white.jpg" alt="EduAsistant Logo" class="landing-logo mb-3" />

        <hr style="width: 150px; border-top: 3px solid white; opacity: 1; margin: 30px 0 15px 0;">

        <h3 class="text-white fw-bold mb-5">Welcome</h3>

        <div class="w-100 px-4" style="max-width: 400px; margin-top: 60px;">
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-light w-100 fw-bold fs-5 mb-4" style="border-radius: 30px; padding: 16px; color: #1F2937; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
                Create Account
            </a>
            <a asp-area="Identity" asp-page="/Account/Login" class="btn w-100 fw-bold fs-5 text-white" style="border-radius: 30px; padding: 16px; border: 2px solid white; background-color: transparent;">
                Log in
            </a>
        </div>
    </div>
}
else
{
    <div class="row mb-5 mt-4">
        <div class="col-md-6 mb-4 mb-md-0 d-flex flex-column justify-content-center">
            <h1 class="fw-bolder mb-1 text-capitalize" style="font-size: 2.5rem;">Hi @userName! 👋</h1>
            <p class="text-muted fs-5">Let's crush your goals today</p>
        </div>

        <div class="col-md-6">
            <div class="d-flex gap-3 h-100">
                <div class="stat-card orange flex-fill d-flex flex-column justify-content-center" style="border-radius: 20px; padding: 25px; color: white; background-color: #F97316;">
                    <h2 class="fw-bold mb-0">12 🔥</h2>
                    <span>Day streak</span>
                </div>
                <div class="stat-card green flex-fill d-flex flex-column justify-content-center" style="border-radius: 20px; padding: 25px; color: white; background-color: #10B981;">
                    <h2 class="fw-bold mb-0">1.4h</h2>
                    <span>Focused</span>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">Your Courses</h3>
        <a asp-controller="Subjects" asp-action="Create" class="btn btn-purple d-flex align-items-center gap-2" style="background-color: #8B5CF6; color: white; border-radius: 16px; padding: 12px 20px; font-weight: bold; text-decoration: none;">
            <span class="fs-5">+</span> Add New Course
        </a>
    </div>

    <div class="course-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px;">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                // Zbieramy wszystkie tematy, liczymy je i wyliczamy postęp
                var allTopics = item.Syllabuses?.SelectMany(s => s.Topics).ToList() ?? new List<EduAsistant.Models.Topic>();
                int chaptersCount = allTopics.Count;
                int completedChapters = allTopics.Count(t => t.IsCompleted);
                int progressPercentage = chaptersCount > 0 ? (int)Math.Round((double)completedChapters / chaptersCount * 100) : 0;

                <a asp-controller="Subjects" asp-action="Details" asp-route-id="@item.Id"
                   class="course-card text-decoration-none d-block"
                   style="background: #fff; border-radius: 20px; padding: 25px; border-left: 8px solid @item.Color; box-shadow: 0 4px 15px rgba(0,0,0,0.03); transition: all 0.3s ease; cursor: pointer;"
                   onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 10px 25px rgba(0,0,0,0.08)';"
                   onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 15px rgba(0,0,0,0.03)';">

                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0 text-dark">@item.Name</h5>
                        <span class="exam-badge" style="background-color: #F3F4F6; color: #6B7280; font-size: 0.8rem; padding: 6px 12px; border-radius: 10px; font-weight: 600;">
                            🗓 @item.ExamDate.ToString("MMM dd", new System.Globalization.CultureInfo("en-US"))
                        </span>
                    </div>

                    <div class="text-muted small mt-2 fw-semibold">@completedChapters / @chaptersCount chapters completed</div>

                    <div class="progress-bg" style="height: 8px; background: #F3F4F6; border-radius: 4px; margin: 20px 0;">
                        <div class="progress-fill" style="width: @progressPercentage%; height: 100%; border-radius: 4px; background-color: @item.Color; transition: width 1s ease-out;"></div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center fw-bold" style="font-size: 0.9rem;">
                        <span style="color: @item.Color;">@progressPercentage% mastered</span>
                        <span class="text-muted fs-5 fw-bolder" style="opacity: 0.6;">&gt;</span>
                    </div>
                </a>
            }
        }
        else
        {
            <div class="col-12 text-center p-5 rounded-4" style="background: #fff; border: 2px dashed #E5E7EB; grid-column: 1 / -1;">
                <p class="text-muted fs-5 mb-0">No courses yet. Click the "+ Add New Course" button above to upload your first syllabus!</p>
            </div>
        }
    </div>
}