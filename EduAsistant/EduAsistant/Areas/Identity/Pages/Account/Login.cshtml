@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
    // Upewniamy się, że korzystamy z naszego głównego układu
    Layout = "/Views/Shared/_Layout.cshtml";
}


<style>
    header {
        display: none !important;
    }
</style>

<div class="container mt-5" style="max-width: 500px;">

    <div class="bg-white rounded-4 p-5 shadow-sm border border-light">

        <div class="text-center mb-4">
            <h2 class="fw-bolder mb-2 text-dark">Welcome back</h2>
            <p class="text-muted small">Log in to your EduAsistant account</p>
        </div>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

            <div class="mb-3">
                <label class="custom-label" asp-for="Input.Email">EMAIL ADDRESS</label>
                <input asp-for="Input.Email" class="form-control custom-input" autocomplete="username" aria-required="true" placeholder="ex : kacper@edu.pl" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="custom-label" asp-for="Input.Password">PASSWORD</label>
                <input asp-for="Input.Password" class="form-control custom-input" autocomplete="current-password" aria-required="true" placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4 fs-7">
                <div class="form-check">
                    <input class="form-check-input" asp-for="Input.RememberMe" style="cursor: pointer;" />
                    <label class="form-check-label text-muted" asp-for="Input.RememberMe" style="cursor: pointer;">
                        Remember me
                    </label>
                </div>
                <a id="forgot-password" asp-page="./ForgotPassword" class="text-decoration-none fw-semibold" style="color: #8B5CF6;">
                    Forgot Password?
                </a>
            </div>

            <button id="login-submit" type="submit" class="btn btn-purple w-100 fs-6 py-3">Log In</button>
        </form>

        <div class="text-center mt-4 text-muted small fw-semibold">
            Don't have an account?
            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none" style="color: #8B5CF6;">
                Sign Up
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}